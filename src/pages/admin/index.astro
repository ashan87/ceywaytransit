// Deliberately not linked from public navigation. worker.ts checks Access JWT before serving it.
---
<!doctype html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Enquiry Dashboard — CEYWAY TRANSIT</title>
<style>
:root{font-family:system-ui,-apple-system,'Segoe UI',sans-serif;color:#174a52;background:#f4fcf9}*{box-sizing:border-box}body{margin:0}button,input,select,textarea{font:inherit}button{cursor:pointer}header{padding:19px max(4%,calc((100% - 1120px)/2));background:#087b82;color:#fff;display:flex;flex-wrap:wrap;justify-content:space-between;gap:15px;align-items:center}header strong{font-size:1.2rem}header a{color:#fff}main{max-width:1140px;padding:28px 20px 80px;margin:auto}h1{font-size:clamp(1.8rem,4vw,2.6rem);margin:0 0 8px}p{color:#4b7575} .hint{font-size:.83rem}.toolbar{display:flex;flex-wrap:wrap;align-items:end;gap:15px;margin:24px 0}.toolbar label{font-size:.84rem;font-weight:700;display:grid;gap:5px}input,select,textarea{border:1px solid #c9e1dd;background:white;border-radius:10px;padding:10px 12px;min-height:43px}.toolbar button,.small-button{border:0;color:white;background:#0a8e91;padding:11px 16px;border-radius:10px;font-weight:700}.small-button{font-size:.8rem;padding:8px 12px}.delete-button{background:#a63835}.box{background:#fff;border:1px solid #d7eeeb;border-radius:20px;padding:22px;box-shadow:0 12px 45px rgba(2,82,80,.05)}table{border-collapse:collapse;width:100%;font-size:.85rem}th{text-align:left;color:#507778;font-size:.75rem;text-transform:uppercase;letter-spacing:.05em}th,td{padding:13px 10px;border-bottom:1px solid #eaf4f1;vertical-align:top}th:first-child,td:first-child{padding-left:0}td button{background:none;border:0;color:#00777f;text-decoration:underline;text-align:left;padding:0;font-weight:750} .table-wrap{overflow-x:auto}.pill{display:inline-block;border-radius:99px;padding:4px 10px;background:#e2f5f1;color:#086669;font-weight:700;font-size:.75rem}.detail{display:none;margin-top:20px;padding:20px;background:#f3fbf7;border-radius:14px}.detail.visible{display:block} .detail-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.detail .full{grid-column:1/-1}.detail strong{display:block;font-size:.78rem;color:#366c70}.detail p{margin:4px 0 8px;overflow-wrap:anywhere;white-space:pre-wrap;color:#21454b}.detail label{font-size:.85rem;font-weight:700;display:grid;gap:6px}.detail textarea{width:100%;resize:vertical;min-height:80px}.detail-actions{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-top:16px}#message{padding:10px 0;color:#b13f39} #message.ok{color:#006c5b}.empty{padding:40px;text-align:center;color:#537a76}@media(max-width:660px){.detail-grid{grid-template-columns:1fr}th,td{font-size:.75rem;padding:12px 6px}}
</style></head><body>
<header><strong>🌴 CEYWAY TRANSIT / Enquiry Manager</strong><a href="/">← Visit website</a></header>
<main><h1>Customer enquiries</h1><p>View trip requests, reply to travellers using their contact details, and track each enquiry's progress.</p><p class="hint" id="whoami"></p>
<div class="toolbar"><label>Status filter<select id="filter"><option value="">All enquiries</option><option value="new">New</option><option value="contacted">Contacted</option><option value="quoted">Quoted</option><option value="confirmed">Confirmed</option><option value="closed">Closed</option></select></label><button id="reload" type="button">Refresh enquiries</button></div>
<div class="box"><div class="table-wrap"><table><thead><tr><th>Received</th><th>Customer</th><th>Type</th><th>Travel date</th><th>Status</th><th>Open</th></tr></thead><tbody id="results"></tbody></table></div><p id="empty" class="empty">Loading enquiries…</p>
<section class="detail" id="detail" aria-label="Selected enquiry"><h2>Enquiry details</h2><div id="detail-content" class="detail-grid"></div><div class="detail-grid"><label>Status<select id="edit-status"><option value="new">New</option><option value="contacted">Contacted</option><option value="quoted">Quoted</option><option value="confirmed">Confirmed</option><option value="closed">Closed</option></select></label><label class="full">Private notes<textarea id="edit-notes" maxlength="2000" placeholder="Notes visible only to authorised administrators"></textarea></label></div><div class="detail-actions"><button class="small-button" id="save" type="button">Save changes</button><button class="small-button delete-button" id="delete" type="button">Delete enquiry</button><button class="small-button" id="close" type="button">Close details</button></div></section>
<p id="message" role="status" aria-live="polite"></p></div>
</main>
<script>
 type Enquiry={id:string;name:string;email:string;phone:string|null;type:string;message:string;travel_date:string|null;travellers:number|null;interests_json:string;status:string;internal_notes:string;created_at:string;consented_at:string};
 let items:Enquiry[]=[];let selected:Enquiry|null=null;
 const tbody=document.getElementById('results')!;const empty=document.getElementById('empty')!;const detail=document.getElementById('detail')!;const detailContent=document.getElementById('detail-content')!;const message=document.getElementById('message')!;
 function report(value:string,success=false){message.textContent=value;message.classList.toggle('ok',success)}
 function cell(row:HTMLTableRowElement,value:string){const c=document.createElement('td');c.textContent=value;row.append(c);return c;}
 function field(label:string,value:string){const wrap=document.createElement('div');const header=document.createElement('strong');header.textContent=label;const body=document.createElement('p');body.textContent=value||'—';wrap.append(header,body);detailContent.append(wrap);}
 function openItem(id:string){const item=items.find(v=>v.id===id);if(!item)return;selected=item;detail.classList.add('visible');detailContent.replaceChildren();field('Name',item.name);field('Email',item.email);field('Phone',item.phone||'');field('Received',new Date(item.created_at).toLocaleString());field('Type',item.type);field('Travel date',item.travel_date||'Flexible');field('Number of travellers',item.travellers?.toString()||'');let interests='';try{interests=JSON.parse(item.interests_json).join(', ');}catch{}field('Interests',interests);field('Message',item.message);field('Consent recorded',new Date(item.consented_at).toLocaleString());(document.getElementById('edit-status') as HTMLSelectElement).value=item.status;(document.getElementById('edit-notes') as HTMLTextAreaElement).value=item.internal_notes||'';detail.scrollIntoView({behavior:'smooth',block:'nearest'});}
 async function load(){report('');detail.classList.remove('visible');selected=null;empty.hidden=false;empty.textContent='Loading…';tbody.replaceChildren();try{const status=(document.getElementById('filter') as HTMLSelectElement).value;const r=await fetch('/api/admin/enquiries?limit=200'+(status?'&status='+encodeURIComponent(status):''),{cache:'no-store'});if(!r.ok)throw new Error('Access denied or backend not ready ('+r.status+').');const data=await r.json();items=data.items||[];empty.hidden=items.length>0;if(!items.length)empty.textContent='No enquiries found.';for(const item of items){const row=document.createElement('tr');cell(row,new Date(item.created_at).toLocaleDateString());cell(row,item.name);cell(row,item.type==='trip'?'Trip request':'Contact');cell(row,item.travel_date||'—');const sc=cell(row,item.status);sc.classList.add('pill');const action=document.createElement('td');const button=document.createElement('button');button.type='button';button.textContent='Details →';button.onclick=()=>openItem(item.id);action.append(button);row.append(action);tbody.append(row);}}catch(err){empty.textContent='Unable to load enquiries.';report(err instanceof Error?err.message:'Request failed.')}}
 document.getElementById('reload')!.addEventListener('click',load);document.getElementById('filter')!.addEventListener('change',load);document.getElementById('close')!.addEventListener('click',()=>{detail.classList.remove('visible');selected=null;});
 document.getElementById('save')!.addEventListener('click',async()=>{if(!selected)return;const status=(document.getElementById('edit-status') as HTMLSelectElement).value,internalNotes=(document.getElementById('edit-notes') as HTMLTextAreaElement).value;const r=await fetch('/api/admin/enquiries/'+selected.id,{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({status,internalNotes})});if(r.ok){await load();report('Changes saved.',true);}else report('Unable to save changes ('+r.status+').');});
 document.getElementById('delete')!.addEventListener('click',async()=>{if(!selected||!confirm('Permanently delete this customer enquiry? This cannot be undone.'))return;const r=await fetch('/api/admin/enquiries/'+selected.id,{method:'DELETE'});if(r.ok){await load();report('Enquiry deleted.',true);}else report('Unable to delete ('+r.status+').');});
 (async()=>{const r=await fetch('/api/admin/whoami',{cache:'no-store'});if(r.ok){const data=await r.json();document.getElementById('whoami')!.textContent='Signed in: '+data.email;}else report('Cloudflare Access sign-in required before accessing customer information.');await load();})();
</script></body></html>
