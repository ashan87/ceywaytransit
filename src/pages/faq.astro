---
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqList from '../components/FaqList.astro';
---
<BaseLayout title="Frequently Asked Questions" description="Answers to common questions about CEYWAY TRANSIT tour enquiries, transport, pricing and planning.">
 <section class="page-hero page-hero-hill"><div class="container"><span class="eyebrow">HERE TO HELP</span><h1>Questions? <em>We've got you.</em></h1><p>Everything you might want to know before beginning your island adventure.</p></div></section>
 <section class="section"><div class="container faq-layout"><div><span class="eyebrow">THE GOOD-TO-KNOW GUIDE</span><h2>Easy answers for <span class="colour-text">happy travels.</span></h2><p>Can't find an answer? Just say hello on WhatsApp.</p><a href="/contact" class="button button-coral">Contact the team ↗</a></div><FaqList/></div></section>
</BaseLayout>
