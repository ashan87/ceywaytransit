---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatsBar from '../components/StatsBar.astro';
import Features from '../components/home/Features.astro';
import Destinations from '../components/home/Destinations.astro';
import Packages from '../components/home/Packages.astro';
import Steps from '../components/home/Steps.astro';
import Reviews from '../components/home/Reviews.astro';
import Journal from '../components/home/Journal.astro';
import CTA from '../components/home/CTA.astro';
import {home,site,waLink} from '../lib/data';
const sections = {features:Features,destinations:Destinations,packages:Packages,steps:Steps,reviews:Reviews,journal:Journal,cta:CTA};
const ordered = home.sectionOrder.map(key=>sections[key]);
---
<BaseLayout title="Home" description={home.heroDescription} image={home.heroImage}>
<section class="hero-home">
 <div class="hero-backdrop" aria-hidden="true">{home.heroSlides.map((img,i)=><img class:list={['hero-bg-slide',i===0&&'is-first']} src={img} alt="" />)}</div>
 <div class="hero-screen" aria-hidden="true"></div>
 <div class="container hero-main">
   <div class="hero-copy"><div class="hero-pill">🌴 {home.eyebrow}</div><h1>{home.heroTitle}</h1><p class="hero-highlight">{home.heroHighlight}</p><p class="hero-description">{home.heroDescription}</p>
    <div class="hero-actions"><a class="button button-coral button-big" href="/plan-my-trip">Plan my trip <span>↗</span></a><a class="button button-glass button-big" href="/packages">Explore tour ideas <span>→</span></a></div>
    <p class="hero-micro">✦ Custom itineraries <span>✦</span> Private journeys <span>✦</span> Islandwide ideas</p>
   </div>
   <div class="hero-aside"><div class="hero-sun-doodle">☀</div><div class="hero-card"><span class="eyebrow">HELLO FROM PARADISE</span><div class="mini-hero-art"><img src="/images/brand/ceyway-logo.webp" alt="CEYWAY TRANSIT island and plane logo" /></div><strong>{site.subtagline}</strong><p>Good days are made of sunshine and adventures.</p><a href={waLink('Hello! I would like help planning a Sri Lanka trip.')} target="_blank" rel="noopener noreferrer">Let's talk trips ↗</a></div><div class="hero-sticker">🍍 Made for happy travels</div></div>
 </div>
 <a class="scroll-nudge" href="#next">Scroll to explore ↓</a>
</section>
<div id="next"><StatsBar/></div>
{ordered.map((Component)=><Component/>)}
</BaseLayout>
