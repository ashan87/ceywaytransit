---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PackageCard from '../../components/PackageCard.astro';
import PackageFilters from '../../components/PackageFilters.astro';
import {packages,en} from '../../lib/data';
---
<BaseLayout title="Tour Packages" description="Find tropical Sri Lanka holiday ideas, from beach escapes to heritage journeys. Enquire for a custom CEYWAY TRANSIT quotation.">
 <section class="page-hero page-hero-beach"><div class="container"><span class="eyebrow">COLOURFUL ADVENTURES AHEAD</span><h1>Find your kind of <em>paradise.</em></h1><p>From sandy toes to hill-country mornings. Every journey is a starting point, not a fixed itinerary.</p></div></section>
 <section class="section"><div class="container"><PackageFilters/><div id="package-grid" class="package-grid">{packages.map(pkg=><PackageCard pkg={pkg}/>)}</div><p id="packages-empty" class="empty-results" hidden>{en.notices.noResults}</p><p class="sample-disclaimer">All itineraries and photos are illustrative samples. Prices and availability are supplied by individual quotation.</p></div></section>
</BaseLayout>
