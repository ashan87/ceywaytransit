---
import { site,navigation } from '../lib/data';
---
<footer class="footer">
 <div class="container footer-grid">
  <div class="footer-brand">
   <img src={site.logo} alt="CEYWAY TRANSIT logo" width="245" height="62" loading="lazy" />
   <p>{site.footerNote}</p>
   <div class="footer-contact"><a href={`tel:${site.phone}`}>☎ {site.phoneDisplay}</a><a href={`mailto:${site.email}`}>✉ {site.email}</a></div>
  </div>
  {navigation.footer.map(group => <div class="footer-col"><h3>{group.title}</h3>{group.links.map(l => <a href={l.href}>{l.label}</a>)}</div>)}
 </div>
 <div class="container footer-lower"><span>© {new Date().getFullYear()} {site.name}. All rights reserved.</span><span>{site.subtagline} 🌞</span></div>
 {site.demoMode && <div class="demo-footer">DEMO WEBSITE · Illustrative packages, photos and reviews. Confirm facts and policies before launch.</div>}
</footer>
