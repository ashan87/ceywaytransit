{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ceywaytransit1",
  "compatibility_date": "2026-10-21",
  "main": "./worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*",
      "/admin",
      "/admin/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ceywaytransit-enquiries",
      "database_id": "a73fe888-4373-4f26-98aa-a04e47a47889",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFfJdrXjVGgERzJX"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
