---
import BaseLayout from '../layouts/BaseLayout.astro';
import {site} from '../lib/data';
---
<BaseLayout title="Contact Us" description="Get in touch with CEYWAY TRANSIT for personal Sri Lanka travel enquiries.">
 <section class="contact-page"><div class="container"><div class="section-top contact-head"><span class="eyebrow">LET'S GET IN TOUCH</span><h1>Let's start your <span class="colour-text">adventure.</span></h1><p>Questions, trip ideas or a simple hello—we'd love to hear from you.</p></div>
  <div class="contact-form-card">
   <h2>Send us a message 💌</h2><p>Send an enquiry to our travel team, or continue on WhatsApp.</p>
   <form id="contact-form" novalidate>
    <div class="form-grid"><label>Full name *<input type="text" name="name" autocomplete="name" required maxlength="100" placeholder="Your name" /></label><label>Email address *<input type="email" name="email" autocomplete="email" inputmode="email" spellcheck="false" required maxlength="180" placeholder="you@example.com" /></label></div>
    <label>Phone number<input type="tel" name="phone" autocomplete="tel" maxlength="40" placeholder="Including country code (optional)" /></label>
    <label>Your message *<textarea name="message" rows="5" maxlength="1500" required placeholder="Tell us about your dream trip…"></textarea></label>
    <input type="text" name="website" class="enquiry-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <label class="enquiry-consent"><input name="consent" type="checkbox" required /> I agree to CEYWAY TRANSIT using my details to respond to this enquiry. See <a href="/privacy/">Privacy Policy</a>.</label>
    <div id="contact-turnstile" class="enquiry-turnstile"></div>
    <p id="contact-status" class="enquiry-feedback" role="status" aria-live="polite" hidden></p>
    <div class="contact-form-buttons"><button id="contact-save" type="submit" class="button button-coral">Send enquiry securely ↗</button><button id="contact-whatsapp" type="button" class="button button-outline">Continue on WhatsApp ↗</button></div>
    <p class="contact-note">Online enquiries are securely stored for our team when the service is configured. WhatsApp opens separately; you must press Send there. Please do not include passport numbers or payment card details.</p>
   </form>
  </div>
  <div class="contact-cards"><a href={`tel:${site.phone}`} class="contact-mini-card"><span class="contact-icon">📞</span><strong>Call us</strong><span>{site.phoneDisplay}</span></a><a href={`mailto:${site.email}`} class="contact-mini-card"><span class="contact-icon">✉️</span><strong>Email us</strong><span>{site.email}</span></a><a href={`https://wa.me/${site.whatsapp}`} class="contact-mini-card" target="_blank" rel="noopener noreferrer"><span class="contact-icon">💬</span><strong>WhatsApp</strong><span>Let's chat about your trip</span></a></div>
 </div></section>
</BaseLayout>
<script>
 import {prepareVerification,postEnquiry,messageIn} from '../lib/enquiry-client';
 const form=document.getElementById('contact-form') as HTMLFormElement|null;
 if(form){
  const status=document.getElementById('contact-status')!;
  const submitButton=document.getElementById('contact-save') as HTMLButtonElement;
  const security=prepareVerification(document.getElementById('contact-turnstile')!);
  const emailInput=form.querySelector<HTMLInputElement>('input[name="email"]')!;
  const emailPattern=/^[A-Z0-9.!#$%&'*+/=?^_`{|}~-]+@[A-Z0-9](?:[A-Z0-9-]{0,61}[A-Z0-9])?(?:\.[A-Z0-9](?:[A-Z0-9-]{0,61}[A-Z0-9])?)+$/i;
  function validEmail(email:string):boolean {
   if(!email||email.length>180||email.includes('..'))return false;
   const at=email.indexOf('@');
   return at>0&&at===email.lastIndexOf('@')&&at<=64&&!email.startsWith('.')&&!email.slice(0,at).endsWith('.')&&email.slice(at+1).length<=253&&emailPattern.test(email);
  }
  function validateEmail():boolean {
   emailInput.value=emailInput.value.trim();
   emailInput.setCustomValidity('');
   if(emailInput.value&&!validEmail(emailInput.value))emailInput.setCustomValidity('Please enter a valid email address, such as name@example.com.');
   return emailInput.reportValidity();
  }
  emailInput.addEventListener('input',()=>emailInput.setCustomValidity(''));

  security.then(v=>{if(!v.enabled)messageIn(status,'Online enquiries are not yet enabled. Please use WhatsApp or email.',true)});
  form.addEventListener('submit',async(event)=>{
   event.preventDefault();if(!validateEmail()||!form.reportValidity())return;
   const v=await security;if(!v.enabled)return messageIn(status,'Please send your enquiry through WhatsApp while the online form is being configured.',true);
   const token=v.getToken();if(!token)return messageIn(status,'Please complete the security check first.',true);
   const data=new FormData(form);submitButton.disabled=true;submitButton.textContent='Sending…';
   try{
    const result=await postEnquiry({type:'contact',name:data.get('name'),email:data.get('email'),phone:data.get('phone'),message:data.get('message'),website:data.get('website'),consent:data.get('consent')!==null,turnstileToken:token});
    if(!result.ok)throw new Error(result.error||'Unable to save enquiry.');
    form.reset();v.reset();messageIn(status,'Thank you! Your enquiry has been received. Our team will contact you soon.');
   }catch(error){v.reset();messageIn(status,(error instanceof Error?error.message:'Network error.')+' You can also contact us through WhatsApp.',true)}
   finally{submitButton.disabled=false;submitButton.textContent='Send enquiry securely ↗';}
  });
  document.getElementById('contact-whatsapp')?.addEventListener('click',()=>{
   const data=new FormData(form);
   const message=`CEYWAY TRANSIT enquiry\nName: ${data.get('name')||''}\nEmail: ${data.get('email')||''}\nPhone: ${data.get('phone')||''}\n\n${data.get('message')||''}`;
   window.open(`https://wa.me/94711332929?text=${encodeURIComponent(message)}`,'_blank','noopener,noreferrer');
  });
 }
</script>
