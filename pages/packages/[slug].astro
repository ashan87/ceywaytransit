---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PackageCard from '../../components/PackageCard.astro';
import {packages,relatedDestinations,getTheme,waLink,site} from '../../lib/data';
export function getStaticPaths(){return packages.map(pkg=>({params:{slug:pkg.slug},props:{pkg}}));}
const {pkg}=Astro.props;
const nearby=relatedDestinations(pkg.destinations);
const others=packages.filter(p=>p.id!==pkg.id).slice(0,3);
const tourSchema={'@context':'https://schema.org','@type':'TouristTrip','name':pkg.title,'description':pkg.summary,'touristType':pkg.theme,'url':`${site.siteUrl}/packages/${pkg.slug}/`};
---
<BaseLayout title={pkg.title} description={pkg.summary} image={pkg.image} schema={tourSchema}>
 <section class="detail-banner"><img src={pkg.image} alt={`Sample cover for ${pkg.title}`} /><div class="detail-banner-overlay"></div><div class="container detail-banner-content"><a class="back-link" href="/packages">← All tour ideas</a><span class="hero-pill">🌴 {getTheme(pkg.theme)}</span><h1>{pkg.title}</h1><p>{pkg.summary}</p><div class="detail-chips"><span>☀ {pkg.days} days / {pkg.nights} nights</span><span>✦ {pkg.difficulty}</span><span>💌 Custom quotation</span></div></div></section>
 <section class="section"><div class="container detail-grid"><article class="detail-body"><span class="eyebrow">YOUR ISLAND STORY</span><h2>The good stuff, <span class="colour-text">day by day.</span></h2><p>Here’s a sample outline to inspire your plans. The final itinerary will be designed with you and confirmed in writing.</p><h3>Highlights you might love</h3><ul class="highlight-list">{pkg.highlights.map(h=><li>✓ {h}</li>)}</ul><h3>Suggested day-by-day route</h3><div class="itinerary-list">{pkg.itinerary.map(item=><details><summary><span>DAY {String(item.day).padStart(2,'0')}</span><strong>{item.title}</strong><b>+</b></summary><p>{item.description}</p></details>)}</div><h3>Beautiful places along the way</h3><div class="mini-destination-row">{nearby.map(d=><a href={`/destinations/${d.slug}/`}><img src={d.image} alt={d.title} loading="lazy"/><strong>{d.title}</strong><span>↗</span></a>)}</div></article><aside class="enquiry-panel"><span class="eyebrow">LET'S MAKE IT YOURS</span><h3>Ready for an island escape?</h3><p>Tell us your dates and interests. We’ll discuss the options and provide a written quotation.</p><div class="quote-status">{pkg.priceFrom===null?'Price: personal quotation':`${pkg.currency} ${pkg.priceFrom.toLocaleString()}+ (indicative)`}</div><a class="button button-coral button-full" href={waLink(`Hi CEYWAY TRANSIT! I'd like a quote for ${pkg.title} (${pkg.days} days).`)} target="_blank" rel="noopener noreferrer">Ask about this tour ↗</a><a class="button button-outline button-full" href="/plan-my-trip">Customise my trip →</a><div class="aside-note">🔒 No online payment or booking confirmation is taken here.</div><hr/><h4>Suggested inclusions</h4><ul>{pkg.inclusions.map(t=><li>✓ {t}</li>)}</ul><h4>Typically excluded</h4><ul>{pkg.exclusions.map(t=><li>− {t}</li>)}</ul></aside></div></section>
 <section class="section section-mint"><div class="container"><div class="section-head-row"><div><span class="eyebrow">KEEP DREAMING</span><h2>More ways to <span class="colour-text">explore.</span></h2></div><a class="text-arrow" href="/packages">All packages ↗</a></div><div class="package-grid">{others.map(pkg=><PackageCard pkg={pkg}/>)}</div></div></section>
</BaseLayout>
