/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'none'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; form-action 'none'; base-uri 'self'; manifest-src 'self'; upgrade-insecure-requests

/images/*
  Cache-Control: public, max-age=604800

/admin/*
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
